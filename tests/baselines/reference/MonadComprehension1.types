=== MonadComprehension1.ts ===
type Option<A> = Readonly<{
>Option : Readonly<{ value: A | null; }>
>       : ^^^^^^^^^^^^^^^^^^        ^^^^

  value: A | null;
>value : A
>      : ^

}>;

const of = <A>(a: A | null): Option<A> => {
>of : <A>(a: A | null) => Option<A>
>   : ^ ^^ ^^        ^^^^^         
><A>(a: A | null): Option<A> => {  const value = a;  return { value };} : <A>(a: A | null) => Option<A>
>                                                                       : ^ ^^ ^^        ^^^^^         
>a : A
>  : ^

  const value = a;
>value : A
>      : ^
>a : A
>  : ^

  return { value };
>{ value } : { value: A; }
>          : ^^^^^^^^^^^^^
>value : A
>      : ^

};

const flatMap = <A, B>(self: Option<A>, f: (a: A) => Option<B>): Option<B> =>
>flatMap : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
>        : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         
><A, B>(self: Option<A>, f: (a: A) => Option<B>): Option<B> =>  self.value === null ? of<B>(null) : f(self.value) : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
>                                                                                                                 : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         
>self : Readonly<{ value: A; }>
>     : ^^^^^^^^^^^^^^^^^^^^^^^
>f : (a: A) => Option<B>
>  : ^ ^^ ^^^^^         
>a : A
>  : ^

  self.value === null ? of<B>(null) : f(self.value);
>self.value === null ? of<B>(null) : f(self.value) : Readonly<{ value: B; }>
>                                                  : ^^^^^^^^^^^^^^^^^^^^^^^
>self.value === null : boolean
>                    : ^^^^^^^
>self.value : A
>           : ^
>self : Readonly<{ value: A; }>
>     : ^^^^^^^^^^^^^^^^^^^^^^^
>value : A
>      : ^
>of<B>(null) : Readonly<{ value: B; }>
>            : ^^^^^^^^^^^^^^^^^^^^^^^
>of : <A_1>(a: A_1 | null) => Option<A_1>
>   : ^^^^^^ ^^          ^^^^^           
>f(self.value) : Readonly<{ value: B; }>
>              : ^^^^^^^^^^^^^^^^^^^^^^^
>f : (a: A) => Option<B>
>  : ^ ^^ ^^^^^         
>self.value : A
>           : ^
>self : Readonly<{ value: A; }>
>     : ^^^^^^^^^^^^^^^^^^^^^^^
>value : A
>      : ^

const a = do (flatMap) {
>a : Readonly<{ value: number; }>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^

  x <- of(1),
  y <- of(2),
  of(x + y),
};
> : Readonly<{ value: number; }>
> : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^

> : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
> : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         

  value: A | null;
}>;

const of = <A>(a: A | null): Option<A> => {
  const value = a;
  return { value };
};

const flatMap = <A, B>(self: Option<A>, f: (a: A) => Option<B>): Option<B> =>
  self.value === null ? of<B>(null) : f(self.value);

const a = do (flatMap) {
>flatMap : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
>        : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         

  x <- of(1),
>of(1) : Readonly<{ value: number; }>
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>of : <A>(a: A | null) => Option<A>
>   : ^ ^^ ^^        ^^^^^         
>1 : 1
>  : ^

  y <- of(2),
  of(x + y),
};
> : (x: number) => Readonly<{ value: number; }>
> : ^ ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

>x : number
>  : ^^^^^^

  y <- of(2),
  of(x + y),
};
> : Readonly<{ value: number; }>
> : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^

> : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
> : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         

  value: A | null;
}>;

const of = <A>(a: A | null): Option<A> => {
  const value = a;
  return { value };
};

const flatMap = <A, B>(self: Option<A>, f: (a: A) => Option<B>): Option<B> =>
  self.value === null ? of<B>(null) : f(self.value);

const a = do (flatMap) {
>flatMap : <A, B>(self: Option<A>, f: (a: A) => Option<B>) => Option<B>
>        : ^ ^^ ^^    ^^         ^^ ^^                   ^^^^^         

  x <- of(1),
  y <- of(2),
>of(2) : Readonly<{ value: number; }>
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>of : <A>(a: A | null) => Option<A>
>   : ^ ^^ ^^        ^^^^^         
>2 : 2
>  : ^

  of(x + y),
};
> : (y: number) => Readonly<{ value: number; }>
> : ^ ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

>y : number
>  : ^^^^^^

  of(x + y),
>of(x + y) : Readonly<{ value: number; }>
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>of : <A>(a: A | null) => Option<A>
>   : ^ ^^ ^^        ^^^^^         
>x + y : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^

};

