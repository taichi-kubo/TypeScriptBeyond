const a = &{
>a : number
>  : ^^^^^^
>&{  const x = 1;  const y = 2;  return x + y;} : number
>                                               : ^^^^^^
>&{  const x = 1;  const y = 2;  return x + y;} : () => number
>                                               : ^^^^^^^^^^^^
>&{  const x = 1;  const y = 2;  return x + y;} : () => number
>                                               : ^^^^^^^^^^^^

  const x = 1;
>x : 1
>  : ^
>1 : 1
>  : ^

  const y = 2;
>y : 2
>  : ^
>2 : 2
>  : ^

  return x + y;
>x + y : number
>      : ^^^^^^
>x : 1
>  : ^
>y : 2
>  : ^

};

const b = async &{
>b : Promise<number>
>  : ^^^^^^^^^^^^^^^
>async &{  const x = await Promise.resolve(1);  const y = await Promise.resolve(2);  return x + y;} : Promise<number>
>                                                                                                   : ^^^^^^^^^^^^^^^
>async &{  const x = await Promise.resolve(1);  const y = await Promise.resolve(2);  return x + y;} : () => Promise<number>
